@page "/dashboard"
@inject AuthService AuthService
@inject TaskApiService TaskApi
@inject NavigationManager Nav

<PageTitle>Dashboard – EmpTracker</PageTitle>

@if (currentUser is null)
{
    <div class="d-flex justify-content-center align-items-center min-vh-100">
        <div class="spinner-border text-primary"></div>
    </div>
}
else
{
    <div class="container-fluid py-4">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold mb-0">Dashboard</h4>
                <small class="text-muted">Welcome back, @currentUser.Name</small>
            </div>
            <div class="d-flex gap-2">
                @if (currentUser.Role == "Admin")
                {
                    <a href="/tasks" class="btn btn-primary btn-sm">
                        <i class="bi bi-list-task me-1"></i>Manage Tasks
                    </a>
                    <a href="/employees" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-people me-1"></i>Employees
                    </a>
                }
                else
                {
                    <a href="/tasks" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-list-task me-1"></i>My Tasks
                    </a>
                }
                <button class="btn btn-outline-secondary btn-sm" @onclick="Logout">
                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                </button>
            </div>
        </div>

        <!-- Stats Cards -->
        @if (stats is not null)
        {
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center py-3">
                            <div class="fs-2 fw-bold text-primary">@stats.TotalTasks</div>
                            <div class="text-muted small">Total Tasks</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center py-3">
                            <div class="fs-2 fw-bold text-warning">@stats.PendingTasks</div>
                            <div class="text-muted small">Pending</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center py-3">
                            <div class="fs-2 fw-bold text-info">@stats.InProgressTasks</div>
                            <div class="text-muted small">In Progress</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center py-3">
                            <div class="fs-2 fw-bold text-success">@stats.CompletedTasks</div>
                            <div class="text-muted small">Completed</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center py-3">
                            <div class="fs-2 fw-bold text-danger">@stats.HighPriorityTasks</div>
                            <div class="text-muted small">High Priority</div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Recent Tasks -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold border-0 pt-3">Recent Tasks</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Title</th>
                                <th>Assignee</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Due Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in recentTasks)
                            {
                                <tr>
                                    <td>@t.Title</td>
                                    <td>@t.AssigneeName</td>
                                    <td><span class="badge @PriorityBadge(t.Priority)">@t.Priority</span></td>
                                    <td><span class="badge @StatusBadge(t.Status)">@t.Status</span></td>
                                    <td>@t.DueDate.ToString("MMM dd, yyyy")</td>
                                </tr>
                            }
                            @if (!recentTasks.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted py-3">No tasks found.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private LoginResponse? currentUser;
    private DashboardStats? stats;
    private List<RecentTask> recentTasks = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser is null) { Nav.NavigateTo("/login"); return; }

        stats = await TaskApi.GetDashboardStatsAsync();
        recentTasks = await TaskApi.GetRecentTasksAsync();
        StateHasChanged();
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login");
    }

    private static string PriorityBadge(string p) => p switch
    {
        "High"   => "bg-danger",
        "Medium" => "bg-warning text-dark",
        _        => "bg-secondary"
    };

    private static string StatusBadge(string s) => s switch
    {
        "Completed"  => "bg-success",
        "InProgress" => "bg-info text-dark",
        _            => "bg-warning text-dark"
    };
}
