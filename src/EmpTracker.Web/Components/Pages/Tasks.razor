@page "/tasks"
@inject AuthService AuthService
@inject TaskApiService TaskApi
@inject NavigationManager Nav

<PageTitle>Tasks – EmpTracker</PageTitle>

@if (currentUser is null)
{
    <div class="d-flex justify-content-center align-items-center min-vh-100">
        <div class="spinner-border text-primary"></div>
    </div>
}
else
{
    <div class="container-fluid py-4">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold mb-0">Task Management</h4>
                <small class="text-muted">@currentUser.Role view</small>
            </div>
            <div class="d-flex gap-2">
                <a href="/dashboard" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-speedometer2 me-1"></i>Dashboard
                </a>
                @if (currentUser.Role == "Admin")
                {
                    <button class="btn btn-primary btn-sm" @onclick="OpenCreate">
                        <i class="bi bi-plus-lg me-1"></i>New Task
                    </button>
                }
                <button class="btn btn-outline-danger btn-sm" @onclick="Logout">
                    <i class="bi bi-box-arrow-right"></i>
                </button>
            </div>
        </div>

        <!-- Search & Filters -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-12 col-md-5">
                        <input class="form-control" placeholder="Search by title..."
                               @bind="searchText" @bind:event="oninput" @onkeyup="LoadTasks" />
                    </div>
                    <div class="col-6 col-md-3">
                        <select class="form-select" @bind="filterStatus" @bind:after="LoadTasks">
                            <option value="">All Statuses</option>
                            <option>Pending</option>
                            <option>InProgress</option>
                            <option>Completed</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <select class="form-select" @bind="filterPriority" @bind:after="LoadTasks">
                            <option value="">All Priorities</option>
                            <option>Low</option>
                            <option>Medium</option>
                            <option>High</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-1">
                        <button class="btn btn-outline-secondary w-100" @onclick="ClearFilters">Clear</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tasks Table -->
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Title</th>
                                <th>Assignee</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Due Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in tasks)
                            {
                                <tr>
                                    <td class="text-muted small">@t.TaskId</td>
                                    <td>@t.Title</td>
                                    <td>@t.AssigneeName</td>
                                    <td><span class="badge @PriorityBadge(t.Priority)">@t.Priority</span></td>
                                    <td>
                                        @if (currentUser.Role == "Employee")
                                        {
                                            <select class="form-select form-select-sm" style="width:130px"
                                                    value="@t.Status"
                                                    @onchange="e => ChangeStatus(t.TaskId, e.Value!.ToString()!)">
                                                <option>Pending</option>
                                                <option>InProgress</option>
                                                <option>Completed</option>
                                            </select>
                                        }
                                        else
                                        {
                                            <span class="badge @StatusBadge(t.Status)">@t.Status</span>
                                        }
                                    </td>
                                    <td>@t.DueDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (currentUser.Role == "Admin")
                                        {
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEdit(t)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(t)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!tasks.Any())
                            {
                                <tr><td colspan="7" class="text-center text-muted py-4">No tasks found.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Task Modal -->
    @if (showModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@(isEdit ? "Edit Task" : "New Task")</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(modalError))
                        {
                            <div class="alert alert-danger py-2">@modalError</div>
                        }
                        <div class="mb-3">
                            <label class="form-label">Title <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="form.Title" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" rows="3" @bind="form.Description"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Assign To <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="form.AssignedTo">
                                <option value="0">-- Select Employee --</option>
                                @foreach (var emp in employees)
                                {
                                    <option value="@emp.UserId">@emp.Name</option>
                                }
                            </select>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label">Priority</label>
                                <select class="form-select" @bind="form.Priority">
                                    <option>Low</option>
                                    <option>Medium</option>
                                    <option>High</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label">Status</label>
                                <select class="form-select" @bind="form.Status">
                                    <option>Pending</option>
                                    <option>InProgress</option>
                                    <option>Completed</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Due Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" @bind="form.DueDate" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                        <button class="btn btn-primary" @onclick="SaveTask" disabled="@isSaving">
                            @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            @(isEdit ? "Update" : "Create")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Delete Confirm Modal -->
    @if (taskToDelete is not null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content">
                    <div class="modal-body text-center py-4">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-1"></i>
                        <p class="mt-2">Delete <strong>@taskToDelete.Title</strong>?</p>
                    </div>
                    <div class="modal-footer justify-content-center">
                        <button class="btn btn-secondary btn-sm" @onclick="() => taskToDelete = null">Cancel</button>
                        <button class="btn btn-danger btn-sm" @onclick="DeleteTask">Delete</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private LoginResponse? currentUser;
    private List<TaskDto> tasks = [];
    private List<EmployeeDto> employees = [];

    private string searchText = "";
    private string filterStatus = "";
    private string filterPriority = "";

    private bool showModal;
    private bool isEdit;
    private bool isSaving;
    private string? modalError;
    private TaskDto? taskToDelete;

    private CreateTaskRequest form = new() { DueDate = DateTime.Today.AddDays(7) };
    private int editTaskId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser is null) { Nav.NavigateTo("/login"); return; }

        await LoadTasks();

        if (currentUser.Role == "Employee")
            employees = await TaskApi.GetEmployeesAsync();

        StateHasChanged();
    }

    private async Task LoadTasks()
    {
        var s  = string.IsNullOrWhiteSpace(searchText)     ? null : searchText;
        var st = string.IsNullOrWhiteSpace(filterStatus)   ? null : filterStatus;
        var pr = string.IsNullOrWhiteSpace(filterPriority) ? null : filterPriority;
        tasks = await TaskApi.GetTasksAsync(s, st, pr);
    }

    private async Task ClearFilters()
    {
        searchText = filterStatus = filterPriority = "";
        await LoadTasks();
    }

    private void OpenCreate()
    {
        isEdit = false;
        form = new CreateTaskRequest { DueDate = DateTime.Today.AddDays(7), Priority = "Medium", Status = "Pending" };
        modalError = null;
        showModal = true;
    }

    private void OpenEdit(TaskDto t)
    {
        isEdit = true;
        editTaskId = t.TaskId;
        form = new CreateTaskRequest
        {
            Title = t.Title, Description = t.Description, AssignedTo = t.AssignedTo,
            Priority = t.Priority, Status = t.Status, DueDate = t.DueDate
        };
        modalError = null;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task SaveTask()
    {
        if (string.IsNullOrWhiteSpace(form.Title) || form.AssignedTo == 0)
        {
            modalError = "Title and Assignee are required.";
            return;
        }

        isSaving = true;
        bool ok;

        if (isEdit)
        {
            var req = new UpdateTaskRequest
            {
                TaskId = editTaskId, Title = form.Title, Description = form.Description,
                AssignedTo = form.AssignedTo, Priority = form.Priority,
                Status = form.Status, DueDate = form.DueDate
            };
            ok = await TaskApi.UpdateTaskAsync(editTaskId, req);
        }
        else
        {
            ok = await TaskApi.CreateTaskAsync(form);
        }

        isSaving = false;
        if (ok) { showModal = false; await LoadTasks(); }
        else modalError = "Operation failed. Please try again.";
    }

    private void ConfirmDelete(TaskDto t) => taskToDelete = t;

    private async Task DeleteTask()
    {
        if (taskToDelete is null) return;
        await TaskApi.DeleteTaskAsync(taskToDelete.TaskId);
        taskToDelete = null;
        await LoadTasks();
    }

    private async Task ChangeStatus(int taskId, string status)
    {
        await TaskApi.UpdateStatusAsync(taskId, status);
        await LoadTasks();
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login");
    }

    private static string PriorityBadge(string p) => p switch
    {
        "High"   => "bg-danger",
        "Medium" => "bg-warning text-dark",
        _        => "bg-secondary"
    };

    private static string StatusBadge(string s) => s switch
    {
        "Completed"  => "bg-success",
        "InProgress" => "bg-info text-dark",
        _            => "bg-warning text-dark"
    };
}
